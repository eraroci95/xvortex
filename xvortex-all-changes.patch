+        lim.record(f"old{i}")
+    c.t = 61  # all ten have expired
+    lim.record("fresh")
+    assert set(lim._events) == {"fresh"}
+    for i in range(100):  # a flood of live keys cannot grow the table past the cap
+        lim.record(f"flood{i}")
