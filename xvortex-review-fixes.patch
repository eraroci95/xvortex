diff --git a/backend/app/core/clientip.py b/backend/app/core/clientip.py
new file mode 100644
index 0000000..c72788e
--- /dev/null
+++ b/backend/app/core/clientip.py
@@ -0,0 +1,21 @@
+import ipaddress
+
+
+def resolve_client_ip(peer: str | None, forwarded_for: str | None, trusted_hops: int) -> str:
+    """Best-effort client address behind `trusted_hops` reverse proxies that each append to X-Forwarded-For.
+
+    A proxy appends the address it saw to the header, so entries on the right were written by
+    infrastructure you control and entries on the left can be forged by the client. The address
+    `trusted_hops` places from the right is the first one a trusted proxy recorded. If the header is
+    missing, too short or malformed, fall back to the socket peer rather than trusting it.
+    """
+    peer = (peer or "unknown")[:45]
+    if trusted_hops <= 0 or not forwarded_for:
+        return peer
+    parts = [p.strip() for p in forwarded_for.split(",") if p.strip()]
+    if len(parts) < trusted_hops:
+        return peer
+    try:
+        return str(ipaddress.ip_address(parts[-trusted_hops]))
+    except ValueError:
+        return peer
diff --git a/backend/app/core/concurrency.py b/backend/app/core/concurrency.py
new file mode 100644
index 0000000..579def8
--- /dev/null
+++ b/backend/app/core/concurrency.py
@@ -0,0 +1,26 @@
+import threading
+from collections.abc import Callable
+
+
+class Slots:
+    """Context manager that lets at most `size()` threads inside at once; the others wait.
+
+    The size is read on first use, so settings are not touched at import time.
+    """
+
+    def __init__(self, size: Callable[[], int]):
+        self._size = size
+        self._sem: threading.BoundedSemaphore | None = None
+        self._guard = threading.Lock()
+
+    def _semaphore(self) -> threading.BoundedSemaphore:
+        with self._guard:
+            if self._sem is None:
+                self._sem = threading.BoundedSemaphore(max(1, self._size()))
+            return self._sem
+
+    def __enter__(self) -> None:
+        self._semaphore().acquire()
+
+    def __exit__(self, *exc: object) -> None:
+        self._semaphore().release()
