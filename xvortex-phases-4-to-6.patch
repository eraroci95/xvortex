diff -ruN '--exclude=.git' '--exclude=__pycache__' '--exclude=node_modules' snap_before_p4/backend/app/services/paper/engine.py xvortex/backend/app/services/paper/engine.py
--- a/backend/app/services/paper/engine.py	1970-01-01 01:00:00.000000000 +0100
+++ b/backend/app/services/paper/engine.py	2026-11-26 23:53:18.700488619 +0100
@@ -0,0 +1,84 @@
+"""Simulated trade arithmetic. Pure functions, exact Decimal. Long-only: no shorting, no margin.
+
+Cash is rounded to 0.01, prices to 6 decimals, quantities to 8. Buying updates a volume-weighted
+average entry price; selling realises profit against that average. Nothing here touches a database.
+"""
+from dataclasses import dataclass
+from decimal import ROUND_HALF_UP, Decimal
+
+CENT = Decimal("0.01")
+PRICE_Q = Decimal("0.000001")
+ZERO = Decimal("0.00")
+
+
+class TradeError(ValueError):
+    """The order cannot be filled (not enough cash or shares)."""
+
+
+def money(x: Decimal) -> Decimal:
+    return x.quantize(CENT, rounding=ROUND_HALF_UP)
+
+
+def price_q(x: Decimal) -> Decimal:
+    return x.quantize(PRICE_Q, rounding=ROUND_HALF_UP)
+
+
+@dataclass(frozen=True)
+class Position:
+    quantity: Decimal
+    avg_entry_price: Decimal
+    realized_pnl: Decimal
+
+
+@dataclass(frozen=True)
+class Fill:
+    cash: Decimal  # cash after the trade
+    position: Position
+    realized_pnl: Decimal | None  # this trade's profit; None for a buy
+    gross: Decimal  # quantity x price, rounded to cents
+
+
+def buy(cash: Decimal, pos: Position, quantity: Decimal, price: Decimal, fees: Decimal = ZERO) -> Fill:
+    _check(quantity, price)
+    gross = money(quantity * price)
+    total = gross + fees
+    if total > cash:
+        raise TradeError(f"Not enough cash: this costs {total} and the account has {cash}.")
+    new_qty = pos.quantity + quantity
+    # Fees are not folded into the average: they reduce cash and are reported on the trade.
+    avg = price_q((pos.quantity * pos.avg_entry_price + quantity * price) / new_qty)
+    return Fill(money(cash - total), Position(new_qty, avg, pos.realized_pnl), None, gross)
+
+
+def sell(cash: Decimal, pos: Position, quantity: Decimal, price: Decimal, fees: Decimal = ZERO) -> Fill:
+    _check(quantity, price)
+    if quantity > pos.quantity:
+        raise TradeError(f"You hold {pos.quantity.normalize():f} and tried to sell {quantity.normalize():f}.")
+    gross = money(quantity * price)
+    pnl = money(quantity * (price - pos.avg_entry_price) - fees)
+    new_qty = pos.quantity - quantity
+    return Fill(
+        money(cash + gross - fees),
+        Position(new_qty, pos.avg_entry_price, money(pos.realized_pnl + pnl)),
+        pnl, gross,
+    )
+
+
+def _check(quantity: Decimal, price: Decimal) -> None:
+    if quantity <= 0:
+        raise TradeError("Quantity must be positive.")
+    if price <= 0:
+        raise TradeError("Price must be positive.")
+
+
+@dataclass(frozen=True)
+class Valuation:
+    market_value: Decimal
+    cost_basis: Decimal
+    unrealized_pnl: Decimal
+
+
+def value_position(pos: Position, last_close: Decimal) -> Valuation:
+    value = money(pos.quantity * last_close)
+    cost = money(pos.quantity * pos.avg_entry_price)
+    return Valuation(value, cost, money(value - cost))
diff -ruN '--exclude=.git' '--exclude=__pycache__' '--exclude=node_modules' snap_before_p4/backend/tests/test_loan_schemas.py xvortex/backend/tests/test_loan_schemas.py
--- a/backend/tests/test_loan_schemas.py	1970-01-01 01:00:00.000000000 +0100
+++ b/backend/tests/test_loan_schemas.py	2026-11-26 23:35:57.558814666 +0100
@@ -0,0 +1,63 @@
+from datetime import date
+from decimal import Decimal as D
+
+import pytest
+
+pytest.importorskip("pydantic")
+from pydantic import ValidationError  # noqa: E402
+
+from app.api.loan_schemas import BorrowerIn, BorrowerPatch, LoanIn, LoanPatch, PaymentIn  # noqa: E402
+
+BASE = dict(
+    borrower_id="00000000-0000-0000-0000-000000000001", principal="1000.00", annual_interest_rate="7.5",
+    start_date="2026-01-01", maturity_date="2026-12-01",
+)
+
+
+def test_valid_loan_gets_defaults():
+    loan = LoanIn(**BASE)
+    assert loan.currency == "SEK" and loan.repayment_frequency == "monthly" and loan.amortization_method == "annuity"
+    assert loan.principal == D("1000.00")
+
+
+@pytest.mark.parametrize("change", [
+    {"principal": "0"}, {"principal": "-5"}, {"principal": "10.123"}, {"principal": "12345678901234567.00"},
+    {"annual_interest_rate": "-1"}, {"annual_interest_rate": "1000"}, {"annual_interest_rate": "1.00001"},
+    {"currency": "sek"}, {"currency": "SE"}, {"currency": "SEKK"},
+    {"repayment_frequency": "daily"}, {"amortization_method": "balloon"},
+    {"maturity_date": "2026-01-01"}, {"maturity_date": "2025-01-01"},
+])
+def test_invalid_loans_are_rejected(change):
+    with pytest.raises(ValidationError):
+        LoanIn(**{**BASE, **change})
+
+
+def test_borrower_trims_and_clears_blanks():
+    b = BorrowerIn(name="  Anna  ", email="  ", phone="", notes="  ")
+    assert b.name == "Anna" and b.email is None and b.phone is None and b.notes is None
+    with pytest.raises(ValidationError):
+        BorrowerIn(name="   ")
+    with pytest.raises(ValidationError):
+        BorrowerIn(name="A", email="not-an-email")
+
+
+def test_borrower_patch_only_sets_what_is_sent():
+    p = BorrowerPatch(email="")
+    assert p.model_fields_set == {"email"} and p.email is None  # blank clears
+    with pytest.raises(ValidationError):
+        BorrowerPatch(email="bad")
+    with pytest.raises(ValidationError):
+        BorrowerPatch(name=" ")
+
+
+def test_loan_patch_cannot_set_repaid_by_hand():
+    assert LoanPatch(status="closed").status == "closed"
+    with pytest.raises(ValidationError):
+        LoanPatch(status="repaid")
+
+
+def test_payment_rules():
+    assert PaymentIn(paid_on=date(2026, 2, 1), amount="10.50", note=" x ").note == "x"
+    for bad in ("0", "-1", "1.005"):
+        with pytest.raises(ValidationError):
+            PaymentIn(paid_on=date(2026, 2, 1), amount=bad)
