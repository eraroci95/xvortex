+  async function run(fn: () => Promise<Loan>): Promise<boolean> {
+    setBusy(true);
+    setActionError(null);
+    try {
+      setLoan(await fn());
+      return true;
+    } catch (err) {
+      setActionError(message(err));
+      if (err instanceof ApiError && err.status === 404) reload();
+      return false;
+    } finally {
+      setBusy(false);
