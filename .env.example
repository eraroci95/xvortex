# Copy to backend/.env for local development. NEVER commit real values.
# Unset means production. Local development needs development.
ENVIRONMENT=development
# Neon connection string (Dashboard > Connection details). Keep sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
CORS_ORIGINS=http://localhost:5173
SESSION_TTL_MINUTES=720
# Reverse proxies in front of the API that append to X-Forwarded-For (0 locally, 1 on Render).
TRUSTED_PROXY_HOPS=0
# Password hashes allowed to run at once (each uses about 64 MiB).
PASSWORD_HASH_CONCURRENCY=2
# Optional first-run admin. Created only when the users table is empty.
# Password must be 12+ characters. Remove ADMIN_PASSWORD from the environment after your first login.
ADMIN_EMAIL=
ADMIN_PASSWORD=
